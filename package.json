{
  "name": "slideapp",
  "private": true,
  "version": "0.1.0",
  "description": "Marp形式のMarkdownをスライド上で直接編集するWindows向けデスクトップアプリ",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@marp-team/marp-core": "4.4.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "html-to-image": "1.11.13",
    "jszip": "3.10.2",
    "markdown-it": "14.3.3",
    "pptxgenjs": "4.0.1",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "26.6.5",
    "happy-dom": "20.14.6",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "5.0.5"
  },
  "overrides": {
    "markdown-it": "14.3.3",
    "@xmldom/xmldom": "0.9.12"
  }
}
